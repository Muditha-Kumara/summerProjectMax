# PostgreSQL Database
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myapp

# Authentication
JWT_SECRET=your_super_secret_jwt_key

# Shelly Cloud API
SHELLY_CLOUD_API_URL=https://shelly-14-eu.shelly.cloud
SHELLY_AUTH_KEY=your_shelly_auth_key
SHELLY_SERVER_ID=your_shelly_server_id

# Nord Pool API
NORD_POOL_API_URL=https://www.nordpoolgroup.com/api/marketdata
NORD_POOL_AREA=FI

# OpenWeatherMap API
OPENWEATHER_API_KEY=your_openweather_api_key

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=Smart Heating <noreply@example.com>

# OpenAI API
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Frontend
FRONTEND_URL=http://localhost:5173