# Server Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_heating
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# User PIN Configuration (for guest access)
USER_PIN_LENGTH=4
USER_PIN_EXPIRES_IN=24h

# Shelly Cloud API
SHELLY_CLOUD_API_URL=https://shelly-14-eu.shelly.cloud
SHELLY_AUTH_KEY=your_shelly_auth_key
SHELLY_SERVER_ID=your_shelly_server_id

# Nord Pool API (Spot Prices)
NORD_POOL_API_URL=https://www.nordpoolgroup.com/api/marketdata
NORD_POOL_AREA=FI

# OpenWeatherMap API
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_LAT=60.1699
OPENWEATHER_LON=24.9384
OPENWEATHER_UNITS=metric

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
SMTP_FROM=Smart Heating <noreply@yourdomain.com>

# OpenAI API (for voice assistant)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
