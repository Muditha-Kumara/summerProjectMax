# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_NAME=smart_heating
DB_USER=postgres
DB_PASSWORD=your_secure_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Shelly Cloud API
SHELLY_CLOUD_API_URL=https://shelly-14-eu.shelly.cloud
SHELLY_AUTH_KEY=your_shelly_auth_key
SHELLY_SERVER_ID=your_shelly_server_id

# Nord Pool API
NORD_POOL_API_URL=https://www.nordpoolgroup.com/api/marketdata
NORD_POOL_AREA=FI

# OpenWeatherMap API
OPENWEATHER_API_KEY=your_openweather_api_key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
SMTP_FROM=Smart Heating <noreply@yourdomain.com>

# OpenAI API
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Frontend URL
FRONTEND_URL=http://localhost:5173
